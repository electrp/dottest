{
  inputs,
  ...
}:
{
  flake.modules.nixos.niri = { pkgs, ... }: {
    imports = [ 
      inputs.niri-flake.nixosModules.niri
    ];
    home-manager.sharedModules = [
      inputs.self.modules.homeManager.niri
    ];
    nixpkgs.overlays = [ inputs.niri-flake.overlays.niri ];

    niri-flake.cache.enable = true;
    programs.niri.enable = true;
    programs.niri.package = pkgs.niri-unstable;

    environment.pathsToLink = [ "/share/applications" "/share/xdg-desktop-portal" ];

    environment.systemPackages = [
      pkgs.waybar
      pkgs.xwayland-satellite
      pkgs.nautilus
      pkgs.xdg-desktop-portal-gnome
    ];

    # KDE generally preferred, as thats what i'm going from
    xdg.portal = {
      enable = true;
      extraPortals = [ 
        pkgs.xdg-desktop-portal-gnome
      ];
      config.common.default = [ "gnome" ];
    };

    environment.sessionVariables.NIXOS_OZONE_WL = "1";
  };

  flake.modules.homeManager.niri = { pkgs, config, ... }: {
    # programs.dank-material-shell = {
    #   enable = true;
    #   enableSystemMonitoring = true;
    #   # dgop.package = inputs.dgop.packages.${pkgs.system}.default;
    #   niri = {
    #     # enableKeybinds = true;   # Sets static preset keybinds
    #     enableSpawn = true;      # Auto-start DMS with niri, if enabled
    #     includes = {
    #       enable = true;             # Enable config includes hack. Enabled by default.
    #       override = true;           # If disabled, DMS settings won't be prioritized over settings defined using niri-flake
    #       originalFileName = "hm";   # A new name (without extension) for the config file generated by niri-flake.
    #       filesToInclude = [         # Files under `$XDG_CONFIG_HOME/niri/dms` to be included into the new config
    #         "alttab"                 # Please note that niri will throw an error if any of these files are missing.
    #         "binds"
    #         "colors"
    #         "cursor"
    #         "layout"
    #         "outputs"
    #         "windowrules"
    #         "wpblur"
    #       ];
    #     };
    #   };
    # };

    programs.niri.settings = 
    { 
      spawn-at-startup = [
        { command = [ "noctalia" ] ; }
      ];
      input.keyboard.xkb.layout = "us";
      window-rules = [
        {
          geometry-corner-radius = 20.0;
          clip-to-geometry = true;
        }
        {
          matches = [
            { app-id = "dev.noctalia.Noctalia"; }
          ];
          open-floating = true;
          default-column-width = { fixed = 1080; };
        }
      ];
      layer-rules = [
        {
          matches = [
            { namespace = "^noctalia-backdrop"; }
          ];
          place-within-backdrop = true;
        }
      ];
      debug = {
        honor-xdg-activation-with-invalid-serial = []; # [] == no argument
      };
      binds = {
        "Mod+Space".action.spawn = [ "noctalia" "msg" "panel-toggle" "launcher" ];
        "Mod+S".action.spawn = [ "noctalia" "msg" "panel-toggle" "control-center" ];
        "Mod+Shift+Comma".action.spawn = [ "noctalia" "msg" "settings-toggle" ];
        "Alt+Tab".action.spawn = [ "noctalia" "msg" "window-switcher" "hold" ];
        "Mod+Tab".action.toggle-overview = {};

        # "F86AudioRaiseVolume".action.spawn = [ "noctalia" "msg" "volume-up" ];
        # "XF86AudioLowerVolume".action.spawn = [ "noctalia" "msg" "volume-down" ];
        # "XF86AudioMute".action.spawn = [ "noctalia" "msg" "volume-mute" ];
        # "XF86MonBrightnessUp".action.spawn = [ "noctalia" "msg" "brightness-up" ];
        # "XF86MonBrightnessDown".action.spawn = [ "noctalia" "msg" "brightness-down" ];

        # Core niri
        # Terminal and Application Launchers
        "Mod+T".action.spawn = "alacritty";
        "Mod+D".action.spawn = "fuzzel";

        # Hotkey Overlay & Shortcuts Inhibit
        "Mod+Shift+Slash".action.show-hotkey-overlay = {};
        "Mod+Escape".action.toggle-keyboard-shortcuts-inhibit = {};

        # Window & Session Controls
        "Mod+Q".action.close-window = {};
        "Alt+F4".action.close-window = {};
        "Mod+Shift+Q".action.quit = { skip-confirmation = true; };

        # Column / Window Focus (Arrow keys & H/J/K/L)
        "Mod+Left".action.focus-column-left = {};
        "Mod+Down".action.focus-window-down = {};
        "Mod+Up".action.focus-window-up = {};
        "Mod+Right".action.focus-column-right = {};
        "Mod+H".action.focus-column-left = {};
        "Mod+J".action.focus-window-down = {};
        "Mod+K".action.focus-window-up = {};
        "Mod+L".action.focus-column-right = {};

        "Mod+R".action.switch-preset-column-width = {};
        "Mod+Shift+R".action.switch-preset-column-width-back = {};
        "Mod+Ctrl+R".action.reset-window-height = {};
        "Mod+Ctrl+Shift+R".action.switch-preset-window-height = {};

        # Moving Columns / Windows
        "Mod+Ctrl+Left".action.move-column-left = {};
        "Mod+Ctrl+Down".action.move-window-down = {};
        "Mod+Ctrl+Up".action.move-window-up = {};
        "Mod+Ctrl+Right".action.move-column-right = {};
        "Mod+Ctrl+H".action.move-column-left = {};
        "Mod+Ctrl+J".action.move-window-down = {};
        "Mod+Ctrl+K".action.move-window-up = {};
        "Mod+Ctrl+L".action.move-column-right = {};
        "Mod+F".action.maximize-column = {};
        "Mod+Shift+F".action.fullscreen-window = {};

        # Workspaces (1 through 9)
        "Mod+1".action.focus-workspace = 1;
        "Mod+2".action.focus-workspace = 2;
        "Mod+3".action.focus-workspace = 3;
        "Mod+4".action.focus-workspace = 4;
        "Mod+5".action.focus-workspace = 5;
        "Mod+6".action.focus-workspace = 6;
        "Mod+7".action.focus-workspace = 7;
        "Mod+8".action.focus-workspace = 8;
        "Mod+9".action.focus-workspace = 9;

        "Mod+Shift+1".action.move-window-to-workspace = 1;
        "Mod+Shift+2".action.move-window-to-workspace = 2;
        "Mod+Shift+3".action.move-window-to-workspace = 3;
        "Mod+Shift+4".action.move-window-to-workspace = 4;
        "Mod+Shift+5".action.move-window-to-workspace = 5;
        "Mod+Shift+6".action.move-window-to-workspace = 6;
        "Mod+Shift+7".action.move-window-to-workspace = 7;
        "Mod+Shift+8".action.move-window-to-workspace = 8;
        "Mod+Shift+9".action.move-window-to-workspace = 9;

        # Media & Volume Keys (with lockscreen allowance)
        # TODO: why not work :(
        /* "XF86AudioMute".action = {
          allow-when-locked = true;
          spawn = [ "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle" ];
        };
        "XF86AudioLowerVolume".action = {
          allow-when-locked = true;
          spawn = [ "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02-" ];
        };
        "XF86AudioRaiseVolume".action = {
          allow-when-locked = true;
          spawn = [ "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02+" ];
        }; */
        "Mod+WheelScrollDown".action.focus-workspace-down = {};
        "Mod+WheelScrollUp".action.focus-workspace-up = {};

        # Column scrolling (Horizontal)
        "Mod+Shift+WheelScrollUp".action.focus-column-left = {};
        "Mod+Shift+WheelScrollDown".action.focus-column-right = {};

        # Moving windows to other workspaces using Shift + Scroll
        "Mod+Ctrl+WheelScrollDown".action.move-column-to-workspace-down = {};
        "Mod+Ctrl+WheelScrollUp".action.move-column-to-workspace-up = {};
      };
      animations.slowdown = 0.5;
      layout = {
        gaps = 2;
      };
    };
  };
}